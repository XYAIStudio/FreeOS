# Local development only. Copy to .env and replace the placeholder secrets.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5174
VITE_GITHUB_URL=https://github.com/XYAIStudio/openXYOS
JWT_SECRET=replace-me-with-a-random-value-of-at-least-32-characters
COOKIE_SECRET=replace-me-with-another-random-value-of-at-least-32-characters
AIR_GAP_MODE=true
DB_DIALECT=sqlite
ALLOW_PUBLIC_REGISTRATION=false
SEED_DEMO_DATA=false
FILE_SCAN_MODE=optional
AGENT_STUDIO_UPLOAD_DIR=

# Required only when SEED_DEMO_DATA=true.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-unique-admin-password
SEED_DEMO_PASSWORD=replace-me-with-a-unique-demo-password

# Optional LLM integration. Leave blank to start without a remote provider.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
MODEL_ENDPOINT_ALLOWLIST=localhost,127.0.0.1,::1,ollama
