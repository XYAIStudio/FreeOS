{
  "name": "openxyos",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch backend/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "postinstall": "node scripts/patch-express-types.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "npm run test:runtime-config && npm run test:r0-access-control && npm run test:module-settings && npm run test:llm-onboarding && npm run test:agent-studio && npm run test:file-security && npm run test:download-token && npm run test:ws-ticket && npm run test:auth-provider && npm run test:pep && npm run test:audit-bundle && npm run test:tool-gateway && npm run test:v100",
    "test:runtime-config": "tsx scripts/test-runtime-config.ts",
    "test:r0-access-control": "tsx scripts/test-r0-access-control.ts",
    "test:file-security": "tsx scripts/test-file-security.ts",
    "test:download-token": "tsx scripts/test-download-token.ts",
    "test:ws-ticket": "tsx scripts/test-ws-ticket.ts",
    "test:auth-provider": "tsx scripts/test-auth-provider.ts",
    "test:pep": "tsx scripts/test-pep.ts",
    "test:audit-bundle": "tsx scripts/test-audit-bundle.ts",
    "test:tool-gateway": "tsx scripts/test-tool-gateway.ts",
    "test:v100": "tsx scripts/test-v100.ts",
    "security:scan": "npm run verify:open-source && npm audit --audit-level=high",
    "audit:legacy-knowledge-files": "tsx scripts/audit-legacy-knowledge-files.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run verify:open-source && npm run build",
    "start": "node --import tsx backend/server.ts",
    "seed": "tsx backend/seed.ts",
    "verify:open-source": "node scripts/verify-open-source.mjs",
    "test:module-settings": "tsx scripts/test-module-settings.ts",
    "test:agent-studio": "tsx scripts/test-agent-studio.ts",
    "test:llm-onboarding": "tsx scripts/test-llm-onboarding.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/multer": "^2.1.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "sql.js": "^1.11.0",
    "ssh2": "^1.17.0",
    "unzipper": "^0.12.3",
    "uuid": "^10.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/iconv-lite": "^0.0.1",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.0"
  },
  "description": "Open-source operating system for governed human-agent organizations",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
